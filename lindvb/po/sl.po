msgstr "Vizualizacija radia"

msgid "Radio visualisation (only for radio and audio)"
msgstr "Vizualizacija radia (samo za radio in zvok)"

msgid "Playback stops at {v0}"
msgstr "Predvajanje se ustavi ob {v0}"

msgid "No programme information for the sleep timer"
msgstr "Ni podatkov o oddaji za časovnik spanja"

msgid "Sleep timer: playback stopped"
msgstr "Časovnik spanja: predvajanje ustavljeno"

msgid "No programme information"
msgstr "Ni podatkov o oddaji"

msgid "Next: {v0}  {title}"
msgstr "Nato: {v0}  {title}"

msgid "Signal {v0}%"
msgstr "Signal {v0} %"

msgid "● REC {n}"
msgstr "● REC {n}"

msgid "Live"
msgstr "V živo"

msgid "Timeshift −{v0}:{v1:02d}"
msgstr "Časovni zamik −{v0}:{v1:02d}"

msgid "Watch and record DVB-S/S2, DVB-C, DVB-T/T2, ATSC and internet TV with the Linux DVB API and GStreamer."
msgstr "Glejte in snemajte DVB-S/S2, DVB-C, DVB-T/T2, ATSC in spletno televizijo z Linux DVB API in GStreamerjem."

msgid "Match IPTV Channels to XMLTV"
msgstr "Poveži kanale IPTV z XMLTV"

msgid "No XMLTV guide loaded yet. Set the XMLTV URL in the EPG settings and download the guide first; matching starts automatically after the download."
msgstr "Vodnik XMLTV še ni naložen. Nastavite naslov XMLTV v nastavitvah EPG in najprej prenesite vodnik; povezovanje se po prenosu začne samodejno."

msgid "Download XMLTV guide now"
msgstr "Prenesi vodnik XMLTV zdaj"

msgid "Only channels without guide"
msgstr "Samo kanali brez vodnika"

msgid "Match"
msgstr "Povezava"

msgid "Guide channel:"
msgstr "Kanal vodnika:"

msgid "Assign"
msgstr "Dodeli"

msgid "Suggest"
msgstr "Predlagaj"

msgid "Auto-match all"
msgstr "Samodejno poveži vse"

msgid "Match every channel that was not assigned by hand"
msgstr "Poveži vsak kanal, ki ni bil dodeljen ročno"

msgid "Reset to automatic"
msgstr "Ponastavi na samodejno"

msgid "Let the automatic matching decide for the selected channel again"
msgstr "Naj za izbrani kanal spet odloča samodejno povezovanje"

msgid "{done} of {v1} channels have a guide channel"
msgstr "Kanal vodnika ima {done} od {v1} kanalov"

msgid "No suggestion for {name}"
msgstr "Ni predloga za {name}"

msgid "Interactive services (HbbTV)"
msgstr "Interaktivne storitve (HbbTV)"

msgid "Media libraries, teletext successors and more behind the red button (F5)."
msgstr "Videoteke, nasledniki teleteksta in drugo za rdečim gumbom (F5)."

msgid "Needs WebKitGTK 6 (gir1.2-webkit-6.0), which is not installed."
msgstr "Potrebuje WebKitGTK 6 (gir1.2-webkit-6.0), ki ni nameščen."

msgid "Start automatically"
msgstr "Zaženi samodejno"

msgid "Off: an application starts only with the red button. Channels' applications send usage data to the broadcaster."
msgstr "Izklopljeno: aplikacija se zažene le z rdečim gumbom. Aplikacije programov pošiljajo podatke o uporabi izdajatelju."

msgid "Allow third-party cookies"
msgstr "Dovoli piškotke tretjih oseb"

msgid "Advertising networks use them to follow you across channels."
msgstr "Oglaševalska omrežja vas z njimi sledijo med programi."

msgid "Delete HbbTV Data"
msgstr "Izbriši podatke HbbTV"

msgid "Cookies and storage"
msgstr "Piškotki in shramba"

msgid "Removes what HbbTV applications stored, such as cookies and settings."
msgstr "Odstrani, kar so shranile aplikacije HbbTV, na primer piškotke in nastavitve."

msgid "HbbTV data deleted"
msgstr "Podatki HbbTV izbrisani"

msgid "HbbTV application could not be loaded: {msg}"
msgstr "Aplikacije HbbTV ni bilo mogoče naložiti: {msg}"

msgid "HbbTV (red button)"
msgstr "HbbTV (rdeči gumb)"

msgid "Interactive service of the channel (red button, F5)"
msgstr "Interaktivna storitev programa (rdeči gumb, F5)"

msgid "Close the interactive service (Esc)"
msgstr "Zapri interaktivno storitev (Esc)"

msgid "HbbTV"
msgstr "HbbTV"

msgid "HbbTV: {name}"
msgstr "HbbTV: {name}"

msgid "Subtitles in media libraries"
msgstr "Podnapisi v videotekah"

msgid "Applications show subtitles in their videos from the start."
msgstr "Aplikacije v svojih videoposnetkih prikažejo podnapise od začetka."

msgid "Audio description in media libraries"
msgstr "Zvočni opis v videotekah"

msgid "Applications prefer the soundtrack that describes the picture."
msgstr "Aplikacije imajo raje zvočni posnetek, ki opisuje sliko."

msgid "WebKit's sandbox may not create user namespaces here (Ubuntu's AppArmor restriction), so applications cannot start safely. See docs/HBBTV.md."
msgstr "Peskovnik WebKit tu ne sme ustvarjati uporabniških imenskih prostorov (omejitev AppArmor v Ubuntu), zato se aplikacije ne morejo varno zagnati. Glej docs/HBBTV.md."
