msgid "Needs WebKitGTK 6 (gir1.2-webkit-6.0), which is not installed."
msgstr "Requer WebKitGTK 6 (gir1.2-webkit-6.0), que não está instalado."

msgid "Start automatically"
msgstr "Iniciar automaticamente"

msgid "Off: an application starts only with the red button. Channels' applications send usage data to the broadcaster."
msgstr "Desligado: uma aplicação só inicia com o botão vermelho. As aplicações dos canais enviam dados de utilização ao operador."

msgid "Allow third-party cookies"
msgstr "Permitir cookies de terceiros"

msgid "Advertising networks use them to follow you across channels."
msgstr "As redes de publicidade usam-nos para o seguir de canal em canal."

msgid "Delete HbbTV Data"
msgstr "Apagar dados HbbTV"

msgid "Cookies and storage"
msgstr "Cookies e armazenamento"

msgid "Removes what HbbTV applications stored, such as cookies and settings."
msgstr "Remove o que as aplicações HbbTV guardaram, como cookies e definições."

msgid "HbbTV data deleted"
msgstr "Dados HbbTV apagados"

msgid "HbbTV application could not be loaded: {msg}"
msgstr "Não foi possível carregar a aplicação HbbTV: {msg}"

msgid "HbbTV (red button)"
msgstr "HbbTV (botão vermelho)"

msgid "Interactive service of the channel (red button, F5)"
msgstr "Serviço interativo do canal (botão vermelho, F5)"

msgid "Close the interactive service (Esc)"
msgstr "Fechar o serviço interativo (Esc)"

msgid "HbbTV"
msgstr "HbbTV"

msgid "HbbTV: {name}"
msgstr "HbbTV: {name}"

msgid "Subtitles in media libraries"
msgstr "Legendas nas videotecas"

msgid "Applications show subtitles in their videos from the start."
msgstr "As aplicações mostram legendas nos seus vídeos desde o início."

msgid "Audio description in media libraries"
msgstr "Audiodescrição nas videotecas"

msgid "Applications prefer the soundtrack that describes the picture."
msgstr "As aplicações preferem a faixa de áudio que descreve a imagem."

msgid "WebKit's sandbox may not create user namespaces here (Ubuntu's AppArmor restriction), so applications cannot start safely. See docs/HBBTV.md."
msgstr "A sandbox do WebKit não pode criar espaços de nomes de utilizador aqui (restrição AppArmor do Ubuntu), por isso as aplicações não podem arrancar em segurança. Ver docs/HBBTV.md."

msgid "This interactive service is rated {age}+."
msgstr "Este serviço interativo é para maiores de {age} anos."

msgid "Blocked by youth protection. Set a PIN in the preferences."
msgstr "Bloqueado pelo controlo parental. Defina um PIN nas preferências."

msgid "Too many wrong PINs. Try again in a few minutes."
msgstr "Demasiados PIN errados. Tente novamente dentro de alguns minutos."

msgid "Youth protection"
msgstr "Controlo parental"

msgid "PIN"
msgstr "PIN"

msgid "Unlock"
msgstr "Desbloquear"

msgid "Wrong PIN."
msgstr "PIN errado."

msgid "This video is rated {age}+."
msgstr "Este vídeo é para maiores de {age} anos."

msgid "Teletext of the channel's interactive service (Ctrl+Shift+T)"
msgstr "Teletexto do serviço interativo do canal (Ctrl+Shift+T)"

msgid "Teletext from the interactive service"
msgstr "Teletexto do serviço interativo"

msgid "The TXT button opens the channel's HbbTV teletext where there is one."
msgstr "O botão TXT abre o teletexto HbbTV do canal, quando existe."

msgid "Viewers from {age} years"
msgstr "Espectadores a partir dos {age} anos"

msgid "Applications and their videos rated above this age need the PIN."
msgstr "As aplicações e os seus vídeos classificados acima desta idade pedem o PIN."

msgid "Current PIN"
msgstr "PIN atual"

msgid "Needed to change the youth protection or the PIN."
msgstr "Necessário para alterar o controlo parental ou o PIN."

msgid "New PIN"
msgstr "Novo PIN"

msgid "Leave empty to keep the current PIN."
msgstr "Deixe vazio para manter o PIN atual."

msgid "Youth protection not changed"
msgstr "Controlo parental não alterado"

msgid "The current PIN is wrong."
msgstr "O PIN atual está errado."

msgid "Youth protection needs a PIN"
msgstr "O controlo parental precisa de um PIN"

msgid "Set a PIN to switch on the youth protection."
msgstr "Defina um PIN para ativar o controlo parental."
