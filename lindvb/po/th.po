#: lindvb/ui/dvbi.py
msgid "Lists you add come after the country's list. Their channels are numbered from 1000, 2000 and so on; a channel that is already in an earlier list appears once. LinDVB contacts the address you enter; that server sees your IP address."
msgstr "รายการที่คุณเพิ่มจะต่อจากรายการของประเทศ ช่องของรายการเหล่านั้นจะมีหมายเลขเริ่มที่ 1000, 2000 และต่อไป ช่องที่มีอยู่แล้วในรายการก่อนหน้าจะแสดงเพียงครั้งเดียว LinDVB จะติดต่อที่อยู่ที่คุณป้อน และเซิร์ฟเวอร์นั้นจะเห็นที่อยู่ IP ของคุณ"

#: lindvb/ui/dvbi.py
msgid "Address of a service list or registry"
msgstr "ที่อยู่ของรายการบริการหรือรีจิสทรี"

#: lindvb/ui/dvbi.py
msgid "Country unknown"
msgstr "ไม่ทราบประเทศ"

#: lindvb/ui/dvbi.py
msgid "country unknown"
msgstr "ไม่ทราบประเทศ"

#: lindvb/ui/dvbi.py
msgid "The country the list is for, when the list does not say"
msgstr "ประเทศที่รายการนี้ใช้ เมื่อรายการไม่ได้ระบุ"

#: lindvb/ui/dvbi.py
msgid "Add List"
msgstr "เพิ่มรายการ"

#: lindvb/ui/dvbi.py
msgid "numbers from {first}"
msgstr "หมายเลขตั้งแต่ {first}"

#: lindvb/ui/dvbi.py
msgid "Remove this list and its channels"
msgstr "ลบรายการนี้และช่องของรายการ"

#: lindvb/ui/dvbi.py
msgid "Loading {address}…"
msgstr "กำลังโหลด {address}…"

#: lindvb/ui/dvbi.py
msgid "{address} could not be loaded: {error}"
msgstr "ไม่สามารถโหลด {address}: {error}"

#: lindvb/ui/dvbi.py
msgid "The registry offers no service list."
msgstr "รีจิสทรีไม่มีรายการบริการ"

#: lindvb/ui/dvbi.py
msgid "Choose a List"
msgstr "เลือกรายการ"

#: lindvb/ui/dvbi.py
msgid "This list is already in use."
msgstr "รายการนี้ถูกใช้งานอยู่แล้ว"

#: lindvb/ui/dvbi.py
msgid "Another list is loading. Please try again in a moment."
msgstr "กำลังโหลดรายการอื่นอยู่ โปรดลองอีกครั้งในอีกสักครู่"

#: lindvb/ui/dvbi.py
msgid "Remove the list “{name}” and its {n} channels?"
msgstr "ลบรายการ “{name}” และ {n} ช่องของรายการหรือไม่?"

#: lindvb/ui/dvbi.py
msgid "Favourites keep the channels and show them again when the list is added again."
msgstr "รายการโปรดจะเก็บช่องไว้และแสดงอีกครั้งเมื่อเพิ่มรายการกลับมา"

#: lindvb/ui/dialogs.py
msgid "Language of the interface"
msgstr "ภาษาของส่วนติดต่อ"

#: lindvb/ui/dialogs.py
msgid "A channel or file starts with the sound in this language when it has one (not the original sound of a film or series in another language)."
msgstr "ช่องหรือไฟล์จะเริ่มด้วยเสียงภาษานี้เมื่อมี (ไม่ใช่เสียงต้นฉบับของภาพยนตร์หรือซีรีส์ในภาษาอื่น)"

#: lindvb/ui/dialogs.py
msgid "Start with audio description"
msgstr "เริ่มด้วยเสียงบรรยายภาพ"

#: lindvb/ui/dialogs.py
msgid "Off: the audio description for blind and visually impaired viewers only plays when it is chosen in the audio menu."
msgstr "ปิด: เสียงบรรยายภาพสำหรับผู้พิการทางสายตาและผู้มีสายตาเลือนรางจะเล่นเฉพาะเมื่อเลือกในเมนูเสียงเท่านั้น"

#: lindvb/ui/window.py
msgid "Subtitles via satellite"
msgstr "คำบรรยายผ่านดาวเทียม"

#: lindvb/ui/window.py
msgid "Subtitles via cable"
msgstr "คำบรรยายผ่านเคเบิล"

#: lindvb/ui/window.py
msgid "Subtitles via antenna"
msgstr "คำบรรยายผ่านเสาอากาศ"

#: lindvb/analysis.py
msgid "{n} characters of text"
msgstr "ข้อความ {n} ตัวอักษร"

#: lindvb/analysis.py
msgid "no text, only commands"
msgstr "ไม่มีข้อความ มีแต่คำสั่ง"

#: lindvb/analysis.py
msgid "Closed captions in the video: none so far."
msgstr "คำบรรยายแบบปิดในวิดีโอ: ยังไม่มี"

#: lindvb/analysis.py
msgid "Closed captions in the video ({n} frames with caption data):"
msgstr "คำบรรยายแบบปิดในวิดีโอ ({n} เฟรมที่มีข้อมูลคำบรรยาย):"

#: lindvb/analysis.py
msgid "CEA-608 field {field} (CC{a}/CC{b})"
msgstr "CEA-608 ฟิลด์ {field} (CC{a}/CC{b})"

#: lindvb/analysis.py
msgid "CEA-708 service {n}"
msgstr "CEA-708 บริการ {n}"

#: lindvb/analysis.py
msgid "XDS programme data: {size}"
msgstr "ข้อมูลรายการ XDS: {size}"

#: lindvb/analysis.py
msgid "only padding, no captions"
msgstr "มีแต่การเติมข้อมูล ไม่มีคำบรรยาย"

#: lindvb/progfeatures.py
msgid "Mono"
msgstr "โมโน"

#: lindvb/progfeatures.py
msgid "Stereo"
msgstr "สเตอริโอ"

#: lindvb/progfeatures.py
msgid "Surround sound 5.1"
msgstr "เสียงรอบทิศทาง 5.1"

#: lindvb/progfeatures.py
msgid "Surround sound 7.1"
msgstr "เสียงรอบทิศทาง 7.1"

#: lindvb/progfeatures.py
msgid "Original language"
msgstr "ภาษาต้นฉบับ"

#: lindvb/progfeatures.py
msgid "Clear speech"
msgstr "เสียงพูดชัดเจน"

#: lindvb/progfeatures.py
msgid "Sign language"
msgstr "ภาษามือ"

#: lindvb/ui/window.py
msgid "Hide this notice until the next version"
msgstr "ซ่อนการแจ้งเตือนนี้จนถึงเวอร์ชันถัดไป"

#: lindvb/ui/window.py
msgid "LinDVB {version} is available"
msgstr "LinDVB {version} พร้อมใช้งานแล้ว"

#: lindvb/ui/window.py lindvb/ui/dialogs.py
msgid "Updates"
msgstr "การอัปเดต"

#: lindvb/ui/window.py
msgid "Updated by the package manager"
msgstr "อัปเดตโดยตัวจัดการแพ็กเกจ"

#: lindvb/ui/window.py
msgid "The check for new versions is off (Preferences > General)"
msgstr "การค้นหาเวอร์ชันใหม่ปิดอยู่ (การตั้งค่า > ทั่วไป)"

#: lindvb/ui/window.py
msgid "Up to date (checked {date})"
msgstr "เป็นเวอร์ชันล่าสุด (ตรวจสอบเมื่อ {date})"

#: lindvb/ui/dialogs.py
msgid "Look for new versions"
msgstr "ค้นหาเวอร์ชันใหม่"

#: lindvb/ui/dialogs.py
msgid "Once a day LinDVB asks GitHub for the latest release and shows a notice in the status bar when there is a newer one. Takes effect when you click Save."
msgstr "วันละครั้ง LinDVB จะถาม GitHub ถึงรุ่นล่าสุดและแสดงการแจ้งเตือนในแถบสถานะเมื่อมีรุ่นที่ใหม่กว่า มีผลหลังจากคลิกบันทึก"

#: lindvb/updatecheck.py
msgid "Your package manager or software centre keeps this LinDVB up to date (Snap, Flathub, AUR)."
msgstr "ตัวจัดการแพ็กเกจหรือศูนย์ซอฟต์แวร์ของคุณจะอัปเดต LinDVB นี้ให้ (Snap, Flathub, AUR)"

#: lindvb/updatecheck.py
msgid "This is a development build of the newest code, not a release, so it is not compared with the releases."
msgstr "นี่คือรุ่นพัฒนาจากโค้ดล่าสุด ไม่ใช่รุ่นเผยแพร่ จึงไม่ถูกเปรียบเทียบกับรุ่นเผยแพร่"

#: lindvb/updatecheck.py
msgid "This LinDVB came from its source code or from a package of your distribution, so it is not compared with the releases."
msgstr "LinDVB นี้มาจากซอร์สโค้ดหรือจากแพ็กเกจของดิสทริบิวชันของคุณ จึงไม่ถูกเปรียบเทียบกับรุ่นเผยแพร่"
