msgid "No XMLTV guide loaded yet. Set the XMLTV URL in the EPG settings and download the guide first; matching starts automatically after the download."
msgstr "XMLTV kava pole veel laaditud. Määra EPG seadetes XMLTV aadress ja laadi kava esmalt alla; sidumine algab pärast allalaadimist automaatselt."

msgid "Download XMLTV guide now"
msgstr "Laadi XMLTV kava kohe alla"

msgid "Only channels without guide"
msgstr "Ainult kavata kanalid"

msgid "Match"
msgstr "Sidumine"

msgid "Guide channel:"
msgstr "Kava kanal:"

msgid "Assign"
msgstr "Määra"

msgid "Suggest"
msgstr "Soovita"

msgid "Auto-match all"
msgstr "Seo kõik automaatselt"

msgid "Match every channel that was not assigned by hand"
msgstr "Seo iga kanal, mida pole käsitsi määratud"

msgid "Reset to automatic"
msgstr "Lähtesta automaatseks"

msgid "Let the automatic matching decide for the selected channel again"
msgstr "Lase valitud kanali puhul taas automaatsel sidumisel otsustada"

msgid "{done} of {v1} channels have a guide channel"
msgstr "Kava kanal on {done} kanalil {v1}-st"

msgid "No suggestion for {name}"
msgstr "Kanalile {name} pole soovitust"
