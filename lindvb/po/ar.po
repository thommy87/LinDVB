msgid "For a server the search does not find (another network, or no multicast)."
msgstr "لخادم لا يجده البحث (شبكة أخرى أو بدون multicast)."

msgid "No SAT>IP server added."
msgstr "لم تتم إضافة أي خادم SAT>IP."

msgid "No SAT>IP server answered. Add it by its address below."
msgstr "لم يستجب أي خادم SAT>IP. أضفه بعنوانه أدناه."

msgid "SAT>IP boxes and LNBs, minisatip, FRITZ!Box Cable and other DVB over IP servers in the local network. Their tuners are listed below once the preferences are saved and opened again."
msgstr "أجهزة SAT>IP وLNB، وminisatip، وFRITZ!Box Cable، وخوادم DVB over IP أخرى في الشبكة المحلية. تظهر موالفاتها في القائمة بعد حفظ التفضيلات وفتحها من جديد."

msgid "SAT>IP servers"
msgstr "خوادم SAT>IP"

msgid "Search Network"
msgstr "البحث في الشبكة"

msgid "Searching…"
msgstr "جارٍ البحث…"

msgid "TCP (in the RTSP connection)"
msgstr "TCP (داخل اتصال RTSP)"

msgid "TCP works through firewalls that block the UDP stream."
msgstr "يعمل TCP عبر جدران الحماية التي تحجب تدفق UDP."

msgid "UDP"
msgstr "UDP"

msgid "{n} servers found, {new} new."
msgstr "تم العثور على {n} خوادم، منها {new} جديدة."

msgid "Source: SAT>IP server {host}"
msgstr "المصدر: خادم SAT>IP {host}"

msgid "SAT>IP signal report (RTCP)"
msgstr "تقرير إشارة SAT>IP (RTCP)"

msgid "SAT>IP: the search uses the frequencies of the list (no NIT search)."
msgstr "SAT>IP: يستخدم البحث ترددات القائمة (بدون بحث NIT)."

msgid "The SAT>IP server controls the LNB and the DiSEqC switch; the DiSEqC port chooses its source (1 to 4)."
msgstr "يتحكم خادم SAT>IP في LNB ومفتاح DiSEqC؛ ويختار منفذ DiSEqC مصدره (1 إلى 4)."

msgid "This transponder list has no transponders for this tuner.\n"
msgstr "لا تحتوي قائمة المرسلات المستجيبة هذه على مرسلات لهذا الموالف.\n"

msgid "At start"
msgstr "عند البدء"

msgid "Channel at start"
msgstr "القناة عند البدء"

msgid "Last channel watched"
msgstr "آخر قناة تمت مشاهدتها"

msgid "First channel of the current list"
msgstr "أول قناة في القائمة الحالية"

msgid "A chosen channel"
msgstr "قناة مختارة"

msgid "The current list is the channel list as you left it: TV or radio, filter, group and sort order."
msgstr "القائمة الحالية هي قائمة القنوات كما تركتها: تلفاز أو راديو، والمرشح، والمجموعة، وترتيب الفرز."

msgid "Channel list"
msgstr "قائمة القنوات"

msgid "All channels or one of your favourites lists."
msgstr "كل القنوات أو إحدى قوائم المفضلة لديك."

msgid "Tuned at every start, whichever channel you watched last."
msgstr "يتم ضبطها عند كل بدء، أيًا كانت القناة التي شاهدتها آخر مرة."

msgid "No channel (black screen)"
msgstr "بلا قناة (شاشة سوداء)"

msgid "Lock"
msgstr "قفل"

msgid "Search this satellite"
msgstr "البحث في هذا القمر الصناعي"

msgid "Tick the satellites to search."
msgstr "حدّد الأقمار الصناعية المراد البحث فيها."

msgid "Horizontal"
msgstr "أفقي"

msgid "Vertical"
msgstr "عمودي"

msgid "Left (circular)"
msgstr "يسار (دائري)"

msgid "Right (circular)"
msgstr "يمين (دائري)"

msgid "Auto"
msgstr "تلقائي"

msgid "Add…"
msgstr "إضافة…"

msgid "Tick all"
msgstr "تحديد الكل"

msgid "Tick none"
msgstr "إلغاء تحديد الكل"

msgid "Back to the lists"
msgstr "العودة إلى القوائم"

msgid "Forget the changes to this position and use the transponder lists again"
msgstr "تجاهل تغييرات هذا الموقع واستخدام قوائم المرسلات المستجيبة مجددًا"

msgid "The changed list is kept for this position."
msgstr "تُحفظ القائمة المعدلة لهذا الموقع."

msgid "This transponder is already in the list."
msgstr "هذا المرسل المستجيب موجود في القائمة بالفعل."

msgid "Tick the transponders to search."
msgstr "حدّد المرسلات المستجيبة المراد البحث فيها."

msgid "DVB-S only uses QPSK; choose DVB-S2 for 8PSK, 16APSK and 32APSK."
msgstr "يستخدم DVB-S تعديل QPSK فقط؛ اختر DVB-S2 لـ 8PSK و16APSK و32APSK."

msgid "This transponder is not valid."
msgstr "هذا المرسل المستجيب غير صالح."

msgid "All {n} transponders are searched."
msgstr "يجري البحث في كل المرسلات المستجيبة ({n})."

msgid "{on} of {n} transponders are searched. A search of single transponders does not add the ones the network announces (NIT)."
msgstr "يجري البحث في {on} من {n} مرسلًا مستجيبًا. البحث في مرسلات مستجيبة منفردة لا يضيف ما تعلنه الشبكة (NIT)."

msgid "Edit transponder"
msgstr "تحرير المرسل المستجيب"

msgid "Add transponder"
msgstr "إضافة مرسل مستجيب"

msgid "Transponders of {position}"
msgstr "المرسلات المستجيبة للموقع {position}"

msgid "The list could not be saved."
msgstr "تعذّر حفظ القائمة."

msgid "Transponders: search single ones, add, change or remove them"
msgstr "المرسلات المستجيبة: البحث في بعضها، أو إضافتها أو تغييرها أو إزالتها"

msgid "{n} transponders; where only some are ticked, just those are searched."
msgstr "{n} مرسلًا مستجيبًا؛ حيث يُحدَّد بعضها فقط، يجري البحث فيها وحدها."

msgid "Own transponder list: {positions}."
msgstr "قائمة مرسلات مستجيبة خاصة: {positions}."

msgid "The stream format the server delivers. Choose HLS when the channels do not play as MPEG-TS."
msgstr "صيغة البث التي يرسلها الخادم. اختر HLS إذا لم تعمل القنوات بصيغة MPEG-TS."

msgid "Give the list its own name (also the name of its channel group)"
msgstr "امنح القائمة اسمًا خاصًا بها (وهو أيضًا اسم مجموعة قنواتها)"

msgid "List renamed to {name}"
msgstr "تمت إعادة تسمية القائمة إلى {name}"

msgid "Add Channels…"
msgstr "إضافة قنوات…"

msgid "Add channels"
msgstr "إضافة قنوات"

msgid "Tune a single frequency by hand and compare its channels with the channel list: add new ones, update changed ones, remove old ones."
msgstr "ضبط تردد واحد يدويًا ومقارنة قنواته بقائمة القنوات: إضافة الجديدة وتحديث المتغيرة وإزالة القديمة."

msgid "Unchanged"
msgstr "بلا تغيير"

msgid "Changed"
msgstr "تغيّرت"

msgid "No longer broadcast"
msgstr "لم تعد تُبث"

msgid "Bandwidth"
msgstr "عرض النطاق"

msgid "yes"
msgstr "نعم"

msgid "Add Channels"
msgstr "إضافة قنوات"

msgid "Tune Channel"
msgstr "ضبط التردد"

msgid "No tuner found."
msgstr "لم يُعثر على موالف."

msgid "Log"
msgstr "السجل"

msgid "The PLP of a DVB-T2 multiplex that sends several; -1 leaves the choice to the tuner"
msgstr "‏PLP لمضاعِف DVB-T2 يرسل عدة منها؛ عند -1 يختار الموالف"

msgid "Enter by hand"
msgstr "إدخال يدوي"

msgid "Tuning…"
msgstr "جارٍ الضبط…"

msgid "The tuner could not be used."
msgstr "تعذّر استخدام الموالف."

msgid "No channels found on this frequency."
msgstr "لم يُعثر على قنوات على هذا التردد."

msgid "{same} unchanged, {changed} changed, {new} new, {gone} no longer broadcast."
msgstr "بلا تغيير: {same}، تغيّرت: {changed}، جديدة: {new}، لم تعد تُبث: {gone}."

msgid "Saved: {added} added, {updated} updated, {removed} removed."
msgstr "تم الحفظ: أُضيفت {added}، حُدّثت {updated}، أُزيلت {removed}."

msgid "LinDVB channel file (.json): everything, with the favourites lists"
msgstr "ملف قنوات LinDVB ‏(.json): كل شيء، مع قوائم المفضلة"

msgid "M3U playlist (.m3u): internet channels and DVB-I streams"
msgstr "قائمة تشغيل M3U ‏(.m3u): قنوات الإنترنت وبثوث DVB-I"

msgid "dvbv5 channel file (.conf): tuner channels"
msgstr "ملف قنوات dvbv5 ‏(.conf): قنوات الموالف"

msgid "CSV table (.csv): every channel"
msgstr "جدول CSV ‏(.csv): كل القنوات"

msgid "Export Channel List"
msgstr "تصدير قائمة القنوات"

msgid "TV channels only"
msgstr "القنوات التلفزيونية فقط"

msgid "Radio stations only"
msgstr "المحطات الإذاعية فقط"

msgid "The channels shown in the list ({n})"
msgstr "القنوات المعروضة في القائمة ({n})"

msgid "Save…"
msgstr "حفظ…"

msgid "There are no channels to export."
msgstr "لا توجد قنوات للتصدير."

msgid "None of these {total} channels can be stored in this format; internet channels go into M3U, tuner channels into dvbv5, every channel into CSV or the LinDVB channel file."
msgstr "لا يمكن حفظ أي من هذه القنوات الـ{total} بهذا التنسيق؛ قنوات الإنترنت تُحفظ في M3U، وقنوات الموالف في dvbv5، وكل القنوات في CSV أو في ملف قنوات LinDVB."

msgid "{n} of {total} channels will be saved; the other {skipped} cannot be stored in this format."
msgstr "سيُحفظ {n} من {total} قناة؛ ولا يمكن حفظ الـ{skipped} الأخرى بهذا التنسيق."

msgid "{n} channels will be saved."
msgstr "سيُحفظ {n} قناة."

msgid "Could not save {name}"
msgstr "تعذّر حفظ {name}"

msgid "{n} channels exported to {path}"
msgstr "صُدِّرت {n} قناة إلى {path}"

msgid "Import channel list (LinDVB .json, dvbv5, VDR, lamedb, M3U, CSV, DVBViewer .ini)"
msgstr "استيراد قائمة القنوات (LinDVB .json، dvbv5، VDR، lamedb، M3U، CSV، DVBViewer .ini)"

msgid "Server (host:9981)"
msgstr "الخادم (host:9981)"

msgid "The channels of a Tvheadend server, with its channel tags as groups and its programme guide. Leave user name and password empty when the server does not ask for them. The password is kept in the LinDVB settings."
msgstr "قنوات خادم Tvheadend، مع وسوم القنوات كمجموعات ودليل البرامج الخاص به. اترك اسم المستخدم وكلمة المرور فارغين إذا لم يطلبهما الخادم. تُحفظ كلمة المرور في إعدادات LinDVB."

msgid "Tvheadend: {n} programmes loaded"
msgstr "Tvheadend: تم تحميل {n} برنامج"

#: lindvb/ipstream.py
msgid "Internet stream {host}"
msgstr "بث إنترنت {host}"

#: lindvb/ipstream.py
msgid "the server ended the stream"
msgstr "أنهى الخادم البث"

#: lindvb/ipstream.py
msgid "{host}: {reason} – connecting again in {s} s"
msgstr "{host}: {reason} – إعادة الاتصال بعد {s} ث"

#: lindvb/ipstream.py
msgid "{host}: connected again"
msgstr "{host}: تم الاتصال مجددًا"

#: lindvb/ipstream.py
msgid "could not open the stream"
msgstr "تعذّر فتح البث"

#: lindvb/ui/window.py
msgid "{name}: playing the stream directly, without timeshift ({reason})"
msgstr "{name}: يُعرض البث مباشرة دون إزاحة زمنية ({reason})"

#: lindvb/ui/window.py
msgid "Connection lost ({reason}) – connecting again in {s} s"
msgstr "انقطع الاتصال ({reason}) – محاولة جديدة بعد {s} ث"

#: lindvb/ui/window.py
msgid "Connected again"
msgstr "تم الاتصال مجددًا"

#: lindvb/ui/window.py
msgid "{name} has no catch-up"
msgstr "لا توجد مشاهدة لاحقة لـ {name}"

#: lindvb/ui/window.py
msgid "Catch-up: {title} ({name}, {time})"
msgstr "مشاهدة لاحقة: {title} ({name}، {time})"

#: lindvb/ui/dialogs.py
msgid "Timeshift for internet channels"
msgstr "إزاحة زمنية لقنوات الإنترنت"

#: lindvb/ui/dialogs.py
msgid "Internet TV channels go through the timeshift buffer like a tuner's: pause, jump back and keep the buffer as a recording. Radio streams play directly."
msgstr "تمر قنوات تلفزيون الإنترنت عبر ذاكرة الإزاحة الزمنية مثل الموالف: إيقاف مؤقت والرجوع للخلف والاحتفاظ بالذاكرة كتسجيل. تُعرض بثوث الراديو مباشرة."

#: lindvb/ui/dialogs.py
msgid "Quality of HLS / DASH streams"
msgstr "جودة بثوث HLS / DASH"

#: lindvb/ui/dialogs.py
msgid "Automatic (follows the connection)"
msgstr "تلقائية (تتبع الاتصال)"

#: lindvb/ui/dialogs.py
msgid "Always the best"
msgstr "الأفضل دائمًا"

#: lindvb/ui/dialogs.py
msgid "Automatic switches to a lower quality when the connection gets slow; the buffer keeps what arrived. Always the best looks the same all the time, but stops to wait on a slow connection."
msgstr "التلقائية تنتقل إلى جودة أقل عندما يبطؤ الاتصال، وتحتفظ الذاكرة بما وصل. الأفضل دائمًا تبدو كما هي طوال الوقت، لكنها تتوقف للانتظار مع الاتصال البطيء."

#: lindvb/ui/dialogs.py
msgid "Reconnect internet streams"
msgstr "إعادة اتصال بثوث الإنترنت"

#: lindvb/ui/dialogs.py
msgid "When the connection of an internet or Tvheadend channel breaks, it is opened again after a few seconds, for up to three minutes."
msgstr "عندما ينقطع اتصال قناة إنترنت أو Tvheadend يُعاد فتحه بعد بضع ثوانٍ، لمدة تصل إلى ثلاث دقائق."

#: lindvb/ui/epg.py
msgid "Watch from the Start"
msgstr "المشاهدة من البداية"

#: lindvb/ui/epg.py
msgid "Plays the programme from its start from the provider's archive (catch-up)"
msgstr "يعرض البرنامج من بدايته من أرشيف المزوّد (مشاهدة لاحقة)"
