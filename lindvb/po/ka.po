msgstr "ყოველთვის საუკეთესო"

msgid "Automatic switches to a lower quality when the connection gets slow; the buffer keeps what arrived. Always the best looks the same all the time, but stops to wait on a slow connection."
msgstr "ავტომატური გადადის დაბალ ხარისხზე, როცა კავშირი ნელდება; ბუფერი ინარჩუნებს მიღებულს. „ყოველთვის საუკეთესო“ ყოველთვის ერთნაირად გამოიყურება, მაგრამ ნელ კავშირზე ჩერდება და ელოდება."

msgid "Reconnect internet streams"
msgstr "ინტერნეტ-ნაკადებთან ხელახალი დაკავშირება"

msgid "When the connection of an internet or Tvheadend channel breaks, it is opened again after a few seconds, for up to three minutes."
msgstr "როცა ინტერნეტ- ან Tvheadend-არხის კავშირი წყდება, ის რამდენიმე წამში ხელახლა იხსნება, სამ წუთამდე."

msgid "Watch from the Start"
msgstr "ყურება დასაწყისიდან"

msgid "Plays the programme from its start from the provider's archive (catch-up)"
msgstr "უკრავს გადაცემას დასაწყისიდან პროვაიდერის არქივიდან (catch-up)"

msgid "HLS and DASH internet streams are recorded with one audio track (the preferred language when it is offered)."
msgstr "HLS და DASH ინტერნეტ-ნაკადები იწერება ერთი აუდიოტრეკით (სასურველი ენით, თუ ის შეთავაზებულია)."

msgid "margin"
msgstr "მარაგი"

msgid "pixel"
msgstr "პიქსელი"

msgid "TV"
msgstr "TV"

msgid "Filter"
msgstr "ფილტრი"

msgid "Source or group"
msgstr "წყარო ან ჯგუფი"

msgid "Favourites list"
msgstr "რჩეულების სია"

msgid "For channels whose type was guessed wrong, e.g. internet streams or imported lists"
msgstr "არხებისთვის, რომელთა ტიპიც არასწორად იქნა გამოცნობილი, მაგ. ინტერნეტ-ნაკადები ან შემოტანილი სიები"

msgid "Sort by number to move channels"
msgstr "არხების გადასაადგილებლად დაალაგეთ ნომრით"

msgid "Move up in the channel list (Alt+Up)"
msgstr "არხების სიაში ზემოთ გადატანა (Alt+Up)"

msgid "Move down in the channel list (Alt+Down)"
msgstr "არხების სიაში ქვემოთ გადატანა (Alt+Down)"

msgid "Add to the favourites list"
msgstr "რჩეულების სიაში დამატება"

msgid "Remove from the favourites list"
msgstr "რჩეულების სიიდან წაშლა"

msgid "Move up in the favourites list (Alt+Up)"
msgstr "რჩეულების სიაში ზემოთ გადატანა (Alt+Up)"

msgid "Move down in the favourites list (Alt+Down)"
msgstr "რჩეულების სიაში ქვემოთ გადატანა (Alt+Down)"

msgid "Empty. Drag channels here or use the arrow button."
msgstr "ცარიელია. გადმოათრიეთ არხები აქ ან გამოიყენეთ ისრის ღილაკი."

msgid "No favourites list yet. Use the star of a channel to make one."
msgstr "რჩეულების სია ჯერ არ არის. შესაქმნელად გამოიყენეთ არხის ვარსკვლავი."

msgid "Sort the channel list"
msgstr "არხების სიის დალაგება"

msgid "By group and name"
msgstr "ჯგუფითა და სახელით"

msgid "By the numbers of the DVB-I list"
msgstr "DVB-I სიის ნომრებით"

msgid "{n} channels · drag to reorder"
msgstr "{n} არხი · გადაათრიეთ გადასალაგებლად"

msgid "Shown as the source in the channel list filter. Empty: the name the list gives itself."
msgstr "ნაჩვენებია, როგორც წყარო არხების სიის ფილტრში. ცარიელი: სახელი, რომელსაც სია თავად ირქმევს."

msgid "The name the list gives itself"
msgstr "სახელი, რომელსაც სია თავად ირქმევს"

msgid "Name in the channel list"
msgstr "სახელი არხების სიაში"
