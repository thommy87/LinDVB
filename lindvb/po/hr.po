msgstr "Željeni jezik zvuka"

msgid "Used by \"Preferred language only\" and by MP4, which keeps one track. Audio description tracks are skipped. Without a match the first track is recorded."
msgstr "Koristi se za „Samo željeni jezik” i za MP4, koji zadržava jedan zapis. Zapisi sa zvučnim opisom se preskaču. Bez podudaranja snima se prvi zapis."

msgid "{what}: {items} can only be kept in MPEG-TS, so recordings are saved as TS."
msgstr "{what}: {items} mogu se zadržati samo u MPEG-TS-u, pa se snimke spremaju kao TS."

