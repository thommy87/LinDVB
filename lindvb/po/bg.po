msgstr "Обнови"

msgid "Load the list again: favourites, channel numbers and guide matches stay, channels no longer in the list are removed."
msgstr "Зарежда списъка отново: любимите, номерата на каналите и връзките с програмата остават, каналите, които вече не са в списъка, се премахват."

msgid "Remove"
msgstr "Премахни"

msgid "Remove the list and its channels"
msgstr "Премахни списъка и каналите му"

msgid "{n} removed"
msgstr "{n} премахнати"

msgid "The file has no channels."
msgstr "Файлът няма канали."

