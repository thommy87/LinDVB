msgid "e.g. {example}"
msgstr "օր.՝ {example}"

msgid "The DVB-I channels of the previous country stay until you install a list for {country} or remove them."
msgstr "Նախորդ երկրի DVB-I ալիքները մնում են, մինչև տեղադրեք ցանկ {country}-ի համար կամ հեռացնեք դրանք։"

msgid "The registry offers no service list for {country}."
msgstr "Ռեեստրը {country}-ի համար ծառայությունների ցանկ չի առաջարկում։"

msgid "Please enter a postcode with {n} digits"
msgstr "Մուտքագրեք {n} թվանշանից բաղկացած փոստային ինդեքս"

msgid "DVB-I loads the channel list from the internet. To do so, LinDVB contacts the German service list registry (csr.dvb-i-slr.de), the server of the service list you choose, the servers that host the channel logos and, when the programme guide is switched on, the broadcasters' programme guide servers. These servers see your IP address and the time of the request. If you enter a postcode, it is sent to the service list server so that it can return the channels of your region. LinDVB sends no other personal data and keeps the list and logos only on this computer. Internet channels are streamed from the broadcasters' servers, which may log your requests according to their own privacy policies."
msgstr "DVB-I-ն բեռնում է ալիքների ցանկը համացանցից։ Դրա համար LinDVB-ն կապվում է գերմանական ծառայությունների ցանկերի ռեեստրի (csr.dvb-i-slr.de), ձեր ընտրած ծառայությունների ցանկի սերվերի, ալիքների լոգոները պահող սերվերների, իսկ երբ հաղորդումների ուղեցույցը միացված է՝ նաև հեռարձակողների հաղորդումների ուղեցույցի սերվերների հետ։ Այս սերվերները տեսնում են ձեր IP հասցեն և հարցման ժամանակը։ Եթե մուտքագրեք փոստային ինդեքս, այն ուղարկվում է ծառայությունների ցանկի սերվերին, որպեսզի այն վերադարձնի ձեր տարածաշրջանի ալիքները։ LinDVB-ն այլ անձնական տվյալներ չի ուղարկում և ցանկն ու լոգոները պահում է միայն այս համակարգչում։ Համացանցային ալիքները հոսում են հեռարձակողների սերվերներից, որոնք կարող են գրանցել ձեր հարցումները՝ իրենց սեփական գաղտնիության քաղաքականությունների համաձայն։"

msgid "Antenna, satellite and internet channels are merged into one list without duplicates; a channel you receive by antenna or dish uses that first."
msgstr "Ալեհավաքային, արբանյակային և համացանցային ալիքները միավորվում են մեկ ցանկում՝ առանց կրկնօրինակների, ալեհավաքով կամ ափսեով ստացվող ալիքը նախ օգտագործում է դա։"

msgid "Update the channel list automatically (daily)"
msgstr "Թարմացնել ալիքների ցանկն ավտոմատ (ամեն օր)"

msgid "Warning! With this switched off, LinDVB can no longer keep your channel list up to date with the channels on air."
