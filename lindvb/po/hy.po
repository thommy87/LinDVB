msgstr "CAP"

msgid "Regione"
msgstr "Regione"

msgid "Freeview region"
msgstr "Freeview տարածաշրջան"

msgid "Country"
msgstr "Երկիր"

msgid "Options"
msgstr "Ընտրանքներ"

msgid "Asked in this order, separated by spaces. Press Enter to keep a change; empty brings back the country's registries."
msgstr "Հարցվում են այս հերթականությամբ՝ բացատներով բաժանված։ Սեղմեք Enter՝ փոփոխությունը պահելու համար, դատարկը վերադարձնում է երկրի ռեեստրները։"

msgid "Prefer antenna, cable and satellite to the internet stream when a channel has both"
msgstr "Նախընտրել ալեհավաքը, մալուխը և արբանյակը համացանցային հոսքից, երբ ալիքն ունի երկուսն էլ"

msgid "Registry address"
msgstr "Ռեեստրի հասցե"

