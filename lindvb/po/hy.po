msgstr "LinDVB ալիքների ֆայլ (.json)՝ ամեն ինչ, ընտրյալների ցանկերով"

msgid "M3U playlist (.m3u): internet channels and DVB-I streams"
msgstr "M3U երգացանկ (.m3u)՝ համացանցային ալիքներ և DVB-I հոսքեր"

msgid "dvbv5 channel file (.conf): tuner channels"
msgstr "dvbv5 ալիքների ֆայլ (.conf)՝ թյուների ալիքներ"

msgid "CSV table (.csv): every channel"
msgstr "CSV աղյուսակ (.csv)՝ յուրաքանչյուր ալիք"

msgid "Export Channel List"
msgstr "Արտահանել ալիքների ցանկը"

msgid "TV channels only"
msgstr "Միայն TV ալիքները"

msgid "Radio stations only"
msgstr "Միայն ռադիոկայանները"

msgid "The channels shown in the list ({n})"
msgstr "Ցանկում ցուցադրված ալիքները ({n})"

msgid "Save…"
msgstr "Պահպանել…"

msgid "There are no channels to export."
msgstr "Արտահանելու ալիքներ չկան։"

msgid "None of these {total} channels can be stored in this format; internet channels go into M3U, tuner channels into dvbv5, every channel into CSV or the LinDVB channel file."
msgstr "Այս {total} ալիքներից ոչ մեկը չի կարող պահվել այս ձևաչափով, համացանցային ալիքները գնում են M3U, թյուների ալիքները՝ dvbv5, յուրաքանչյուր ալիք՝ CSV կամ LinDVB ալիքների ֆայլ։"

msgid "{n} of {total} channels will be saved; the other {skipped} cannot be stored in this format."
msgstr "Կպահպանվի {n}՝ {total} ալիքից, մնացած {skipped}-ը չի կարող պահվել այս ձևաչափով։"

msgid "{n} channels will be saved."
msgstr "Կպահպանվի {n} ալիք։"

msgid "Could not save {name}"
msgstr "Չհաջողվեց պահպանել {name}-ը"

msgid "{n} channels exported to {path}"
msgstr "{n} ալիք արտահանվեց {path}"

msgid "Import channel list (LinDVB .json, dvbv5, VDR, lamedb, M3U, CSV, DVBViewer .ini)"
msgstr "Ներմուծել ալիքների ցանկ (LinDVB .json, dvbv5, VDR, lamedb, M3U, CSV, DVBViewer .ini)"

msgid "Server (host:9981)"
msgstr "Սերվեր (host:9981)"

msgid "The channels of a Tvheadend server, with its channel tags as groups and its programme guide. Leave user name and password empty when the server does not ask for them. The password is kept in the LinDVB settings."
msgstr "Tvheadend սերվերի ալիքները՝ իր ալիքների պիտակներով որպես խմբեր և իր հաղորդումների ուղեցույցով։ Թողեք օգտանունը և գաղտնաբառը դատարկ, երբ սերվերը դրանք չի պահանջում։ Գաղտնաբառը պահվում է LinDVB-ի կարգավորումներում։"

msgid "Tvheadend: {n} programmes loaded"
msgstr "Tvheadend՝ բեռնվել է {n} հաղորդում"

msgid "Hardware Tuners"
msgstr "Ապարատային թյուներներ"

msgid "No hardware tuner found."
msgstr "Ապարատային թյուներ չգտնվեց։"

msgid "The Snap package may only use the tuners once its DVB interface is connected: run “sudo snap connect lindvb:dvb” and start LinDVB again."
msgstr "Snap փաթեթը կարող է օգտագործել թյուներները միայն այն բանից հետո, երբ դրա DVB ինտերֆեյսը միացված է՝ գործարկեք «sudo snap connect lindvb:dvb» և կրկին գործարկեք LinDVB-ն։"

msgid "Linux has not set up a DVB device (/dev/dvb is missing). The driver or the firmware of the tuner is probably missing; “dmesg | grep -i dvb” shows what the kernel reports."
msgstr "Linux-ը DVB սարք չի կարգավորել (/dev/dvb-ն բացակայում է)։ Հավանաբար բացակայում է թյուների դրայվերը կամ միկրոծրագիրը, «dmesg | grep -i dvb»-ն ցույց է տալիս, թե ինչ է հաղորդում միջուկը։"

msgid "Connect a tuner and open the preferences again."
msgstr "Միացրեք թյուներ և կրկին բացեք կարգավորումները։"

msgid "{n} tuners found in this computer."
msgstr "Այս համակարգչում գտնվել է {n} թյուներ։"

msgid "1 tuner found in this computer."
msgstr "Այս համակարգչում գտնվել է 1 թյուներ։"

msgid "Tuner {n}: {name}"
msgstr "Թյուներ {n}՝ {name}"

msgid "Internet stream {host}"
msgstr "Համացանցային հոսք {host}"

msgid "the server ended the stream"
msgstr "սերվերն ավարտեց հոսքը"

msgid "{host}: {reason} – connecting again in {s} s"
msgstr "{host}՝ {reason} – կրկին միացում {s} վ-ից"

msgid "{host}: connected again"
msgstr "{host}՝ կրկին միացված է"

msgid "could not open the stream"
msgstr "չհաջողվեց բացել հոսքը"

msgid "{name}: playing the stream directly, without timeshift ({reason})"
msgstr "{name}՝ հոսքը նվագարկվում է ուղղակիորեն՝ առանց Timeshift-ի ({reason})"

msgid "Connection lost ({reason}) – connecting again in {s} s"
msgstr "Կապը կորավ ({reason}) – կրկին միացում {s} վ-ից"

msgid "Connected again"
msgstr "Կրկին միացված է"

msgid "{name} has no catch-up"
msgstr "{name}-ը catch-up չունի"

msgid "Catch-up: {title} ({name}, {time})"
msgstr "Catch-up՝ {title} ({name}, {time})"

msgid "Timeshift for internet channels"
msgstr "Timeshift համացանցային ալիքների համար"

msgid "Internet TV and radio channels go through the timeshift buffer like a tuner's: pause, jump back and keep the buffer as a recording. Radio stations keep their song titles."
msgstr "Համացանցային TV և ռադիո ալիքներն անցնում են Timeshift-ի բուֆերով՝ թյուների ալիքների նման՝ դադար, հետ անցում և բուֆերի պահպանում որպես ձայնագրություն։ Ռադիոկայանները պահպանում են երգերի անունները։"

msgid "Quality of HLS / DASH streams"
msgstr "HLS / DASH հոսքերի որակ"

msgid "Automatic (follows the connection)"
msgstr "Ավտոմատ (հետևում է կապին)"

msgid "Always the best"
msgstr "Միշտ լավագույնը"

msgid "Automatic switches to a lower quality when the connection gets slow; the buffer keeps what arrived. Always the best looks the same all the time, but stops to wait on a slow connection."
msgstr "Ավտոմատը անցնում է ավելի ցածր որակի, երբ կապը դանդաղում է, բուֆերը պահում է ժամանածը։ «Միշտ լավագույնը» միշտ նույնն է երևում, բայց դանդաղ կապի դեպքում կանգ է առնում սպասելու։"

msgid "Reconnect internet streams"
msgstr "Վերամիացնել համացանցային հոսքերը"

msgid "When the connection of an internet or Tvheadend channel breaks, it is opened again after a few seconds, for up to three minutes."
msgstr "Երբ համացանցային կամ Tvheadend ալիքի կապը խզվում է, այն կրկին բացվում է մի քանի վայրկյան հետո՝ մինչև երեք րոպե։"

msgid "Watch from the Start"
msgstr "Դիտել սկզբից"

msgid "Plays the programme from its start from the provider's archive (catch-up)"
msgstr "Նվագարկում է հաղորդումն իր սկզբից՝ մատակարարի արխիվից (catch-up)"

msgid "HLS and DASH internet streams are recorded with one audio track (the preferred language when it is offered)."
msgstr "HLS և DASH համացանցային հոսքերը ձայնագրվում են մեկ աուդիո ուղով (նախընտրելի լեզուն, եթե այն առաջարկվում է)։"

msgid "margin"
msgstr "պաշար"

msgid "pixel"
msgstr "պիքսել"

msgid "TV"
msgstr "TV"

msgid "Filter"
msgstr "Զտիչ"

msgid "Source or group"
msgstr "Աղբյուր կամ խումբ"

msgid "Favourites list"
msgstr "Ընտրյալների ցանկ"

msgid "For channels whose type was guessed wrong, e.g. internet streams or imported lists"
msgstr "Այն ալիքների համար, որոնց տեսակը սխալ է կռահվել, օր.՝ համացանցային հոսքեր կամ ներմուծված ցանկեր"

msgid "Sort by number to move channels"
msgstr "Դասավորեք ըստ համարի՝ ալիքները տեղափոխելու համար"

msgid "Move up in the channel list (Alt+Up)"
msgstr "Տեղափոխել վեր ալիքների ցանկում (Alt+Up)"

msgid "Move down in the channel list (Alt+Down)"
msgstr "Տեղափոխել վար ալիքների ցանկում (Alt+Down)"

msgid "Add to the favourites list"
msgstr "Ավելացնել ընտրյալների ցանկին"

msgid "Remove from the favourites list"
msgstr "Հեռացնել ընտրյալների ցանկից"

msgid "Move up in the favourites list (Alt+Up)"
msgstr "Տեղափոխել վեր ընտրյալների ցանկում (Alt+Up)"

msgid "Move down in the favourites list (Alt+Down)"
msgstr "Տեղափոխել վար ընտրյալների ցանկում (Alt+Down)"

msgid "Empty. Drag channels here or use the arrow button."
msgstr "Դատարկ է։ Քաշեք ալիքներն այստեղ կամ օգտագործեք սլաքով կոճակը։"

msgid "No favourites list yet. Use the star of a channel to make one."
msgstr "Ընտրյալների ցանկ դեռ չկա։ Օգտագործեք ալիքի աստղը՝ այն ստեղծելու համար։"

msgid "Sort the channel list"
msgstr "Դասավորել ալիքների ցանկը"

msgid "By group and name"
msgstr "Ըստ խմբի և անվան"

msgid "By the numbers of the DVB-I list"
msgstr "Ըստ DVB-I ցանկի համարների"

msgid "{n} channels · drag to reorder"
msgstr "{n} ալիք · քաշեք՝ վերադասավորելու համար"

msgid "Shown as the source in the channel list filter. Empty: the name the list gives itself."
msgstr "Ցուցադրվում է որպես աղբյուր ալիքների ցանկի զտիչում։ Դատարկ՝ այն անունը, որ ցանկն ինքն իրեն է տալիս։"

msgid "The name the list gives itself"
msgstr "Այն անունը, որ ցանկն ինքն իրեն է տալիս"

msgid "Name in the channel list"
msgstr "Անունը ալիքների ցանկում"

msgid "All tags"
msgstr "Բոլոր պիտակները"

msgid "Tvheadend channel tag"
msgstr "Tvheadend ալիքի պիտակ"

msgid "{n} min left"
msgstr "Մնաց {n} րոպե"

msgid "Audio description"
msgstr "Աուդիոնկարագրություն"

msgid "Black and white"
msgstr "Սև ու սպիտակ"

msgid "In memory (RAM)"
msgstr "Հիշողության մեջ (RAM)"

msgid "On disk as a file"
msgstr "Սկավառակի վրա՝ որպես ֆայլ"

msgid "Off: live TV cannot pause or jump back. In memory: nothing is written to the disk, but the buffer takes RAM. On disk: the largest buffer."
msgstr "Անջատված՝ ուղիղ TV-ն չի կարող դադարեցվել կամ հետ անցնել։ Հիշողության մեջ՝ սկավառակի վրա ոչինչ չի գրվում, բայց բուֆերը զբաղեցնում է RAM։ Սկավառակի վրա՝ ամենամեծ բուֆերը։"

msgid "Timeshift buffer in memory (MB)"
msgstr "Timeshift-ի բուֆեր հիշողության մեջ (ՄԲ)"

msgid "At most half of the memory ({mb} MB); less when other programs need it."
msgstr "Առավելագույնը հիշողության կեսը ({mb} ՄԲ), ավելի քիչ, երբ այլ ծրագրերին է այն անհրաժեշտ։"

msgid "Less when the disk is almost full ({mb} MB stay free)."
msgstr "Ավելի քիչ, երբ սկավառակը գրեթե լիքն է ({mb} ՄԲ մնում է ազատ)։"

msgid "≈ {sd} SD · {hd} HD · {uhd} UHD"
msgstr "≈ {sd} SD · {hd} HD · {uhd} UHD"

msgid "{m} min"
msgstr "{m} րոպե"

msgid "Timeshift buffer reduced to {mb} MB: {reason}"
msgstr "Timeshift-ի բուֆերը կրճատվեց մինչև {mb} ՄԲ՝ {reason}"

msgid "Timeshift is off for this channel: {reason}"
msgstr "Timeshift-ն անջատված է այս ալիքի համար՝ {reason}"

msgid "not enough free memory"
msgstr "բավարար ազատ հիշողություն չկա"

msgid "the disk is almost full"
msgstr "սկավառակը գրեթե լիքն է"

msgid "Timeshift is off (Preferences › Playback)"
msgstr "Timeshift-ն անջատված է (Կարգավորումներ › Նվագարկում)"

msgid "HbbTV: the application is not signalled on this channel"
msgstr "HbbTV՝ հավելվածը այս ալիքում ազդանշանավորված չէ"

msgid "HbbTV video could not be played: {msg}"
msgstr "HbbTV տեսանյութը չհաջողվեց նվագարկել՝ {msg}"

msgid "unknown error"
msgstr "անհայտ սխալ"

msgid "Diagnostic log"
msgstr "Ախտորոշման գրանցամատյան"

msgid "Records what the applications do and ask of LinDVB in {path}, to attach to a bug report. Takes effect on the next channel change."
msgstr "Գրանցում է, թե ինչ են անում հավելվածները և ինչ են պահանջում LinDVB-ից {path}-ում՝ սխալի հաշվետվությանը կցելու համար։ Ուժի մեջ է մտնում ալիքի հաջորդ փոխման ժամանակ։"

#: lindvb/ui/dialogs.py
msgid "DiSEqC switch"
msgstr "DiSEqC փոխարկիչ"

#: lindvb/ui/dialogs.py
msgid "DiSEqC 1.0 (up to 4 satellites)"
msgstr "DiSEqC 1.0 (մինչև 4 արբանյակ)"

#: lindvb/ui/dialogs.py
msgid "DiSEqC 1.1 (up to 16 satellites)"
msgstr "DiSEqC 1.1 (մինչև 16 արբանյակ)"

#: lindvb/ui/dialogs.py
msgid "DiSEqC 1.1, uncommitted only (up to 16)"
msgstr "DiSEqC 1.1, միայն uncommitted (մինչև 16)"

#: lindvb/ui/dialogs.py
msgid "DiSEqC 1.1 for switches with more than 4 inputs, or an uncommitted switch in front of DiSEqC 1.0 switches. \"Uncommitted only\" for a switch that does not take DiSEqC 1.0 commands."
msgstr "DiSEqC 1.1՝ 4-ից ավելի մուտք ունեցող փոխարկիչների կամ DiSEqC 1.0 փոխարկիչների առջև դրված uncommitted փոխարկիչի համար։ «Միայն uncommitted»՝ այն փոխարկիչի համար, որը չի ընդունում DiSEqC 1.0 հրամաններ։"

#: lindvb/diseqc.py
msgid "SAT>IP: up to 4 satellites (source 1 to 4)."
msgstr "SAT>IP. մինչև 4 արբանյակ (աղբյուր 1-ից 4)։"

#: lindvb/diseqc.py
msgid "Single cable: up to {n} satellite positions."
msgstr "Մեկ մալուխ. մինչև {n} արբանյակային դիրք։"

#: lindvb/diseqc.py
msgid "DiSEqC 1.1 switch: up to 16 satellites (uncommitted and committed)."
msgstr "DiSEqC 1.1 փոխարկիչ. մինչև 16 արբանյակ (uncommitted և committed)։"

#: lindvb/diseqc.py
msgid "DiSEqC 1.1 switch: up to 16 satellites (uncommitted only)."
msgstr "DiSEqC 1.1 փոխարկիչ. մինչև 16 արբանյակ (միայն uncommitted)։"

#: lindvb/diseqc.py
msgid "DiSEqC 1.0 switch: up to 4 satellites. DiSEqC 1.1 (up to 16 satellites) and Unicable (up to 64 positions) are chosen in the tuner settings."
msgstr "DiSEqC 1.0 փոխարկիչ. մինչև 4 արբանյակ։ DiSEqC 1.1-ը (մինչև 16 արբանյակ) և Unicable-ը (մինչև 64 դիրք) ընտրվում են թյուների կարգավորումներում։"

#: lindvb/ui/window.py
msgid "Show your favourites lists (Ctrl+D)"
msgstr "Ցույց տալ ընտրյալների ցանկերը (Ctrl+D)"

#: lindvb/ui/window.py
msgid "Edit this favourites list"
msgstr "Խմբագրել ընտրյալների այս ցանկը"

#: lindvb/ui/window.py
msgid "Area"
msgstr "Տարածք"

#: lindvb/ui/window.py
msgid "All sources"
msgstr "Բոլոր աղբյուրները"

#: lindvb/ui/window.py
msgid "All areas"
msgstr "Բոլոր տարածքները"

#: lindvb/listfilter.py
msgid "DiSEqC port {n}"
msgstr "DiSEqC պորտ {n}"

