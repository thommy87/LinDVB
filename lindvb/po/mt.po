msgstr "Lingwa tal-awdjo ppreferuta"

msgid "Used by \"Preferred language only\" and by MP4, which keeps one track. Audio description tracks are skipped. Without a match the first track is recorded."
msgstr "Tintuża minn “Il-lingwa ppreferuta biss” u mill-MP4, li jżomm binarju wieħed. Il-binarji b'deskrizzjoni awdjo jinqabżu. Mingħajr qbil jiġi rreġistrat l-ewwel binarju."

msgid "{what}: {items} can only be kept in MPEG-TS, so recordings are saved as TS."
msgstr "{what}: {items} jistgħu jinżammu biss f'MPEG-TS, għalhekk ir-reġistrazzjonijiet jiġu ssejvjati bħala TS."

msgid "{what}: {items} can only be kept in TS or MKV, so recordings are saved as TS."
msgstr "{what}: {items} jistgħu jinżammu biss f'TS jew MKV, għalhekk ir-reġistrazzjonijiet jiġu ssejvjati bħala TS."

